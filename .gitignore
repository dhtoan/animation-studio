# upstream source checkouts (audited read-only; never vendored wholesale)
_upstream/
# generated project outputs (renders, audio, caches)
projects/
# local config / secrets
studio.config.json
.env
*.token.json
client_secret*.json
__pycache__/
*.pyc
.DS_Store
# machine-local style verification artefacts (stills + verification.json are kept as evidence)
styles/samples/*.mp4
styles/samples/_work/
# machine-local provider verification (may contain account details)
voice/provider-status.json
# voice sample cache (keep only the named sample-*.wav files)
voice/samples/[0-9a-f]*
tools/bin/
tools/node/node_modules/
